{
  "config": {
    "abort": {
      "no_unconfigured_devices": "No unconfigured devices found.",
      "no_cloud_devices": "No devices were found in this Smart Life / Tuya Smart account."
    },
    "error": {
      "device_not_registered": "Device is not registered in Tuya cloud",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "login_error": "Login error ({code}): {msg}",
      "invalid_mac": "Invalid MAC address format",
      "cloud_error": "Could not read the device list from the Tuya cloud. Check the network connection and try again.",
      "invalid_cloud_device": "This device does not provide Bluetooth (local key) credentials. Select another device."
    },
    "flow_title": "{name}",
    "step": {
      "user": {
        "menu_options": {
          "discover": "Auto-discover devices (Tuya IoT platform account)",
          "manual": "Manual MAC address entry (Tuya IoT platform account)",
          "qr": "Smart Life / Tuya Smart QR code login"
        },
        "description": "Choose how to add your Tuya BLE device. The easiest way is the Smart Life / Tuya Smart QR code login, it needs no Tuya IoT Access ID or Secret."
      },
      "manual": {
        "data": {
          "address": "MAC Address"
        },
        "description": "Enter the MAC address of your Tuya BLE device (e.g., {example_mac}). You can find this in Home Assistant's Bluetooth integration under the device details."
      },
      "manual_confirm": {
        "description": "Device at {address} was not found in Tuya cloud. Make sure the device is registered in the Tuya app. Click Submit to retry."
      },
      "device": {
        "data": {
          "address": "Tuya BLE device"
        },
        "description": "Select Tuya BLE device to setup. Device must be registered in the cloud using the mobile application. It's better to unbind the device from Tuya Bluetooth gateway, if any."
      },
      "login": {
        "data": {
          "access_id": "Tuya IoT Access ID",
          "access_secret": "Tuya IoT Access Secret",
          "country_code": "Country",
          "password": "[%key:common::config_flow::data::password%]",
          "username": "Account"
        },
        "description": "Tuya BLE requires obtaining encryption key from Tuya cloud. Almost all devices only need to access the cloud once during setup.\n\nRefer to documentation of Tuya integration to retrive the cloud credentials https://www.home-assistant.io/integrations/tuya/\n\nEnter your Tuya credentials."
      },
      "cloud_method": {
        "description": "Choose how the credentials of the device are read from the Tuya cloud.",
        "menu_options": {
          "qr": "Smart Life / Tuya Smart QR code login",
          "iot": "Tuya IoT platform account"
        }
      },
      "qr": {
        "data": {
          "user_code": "User code"
        },
        "description": "Enter the user code of your Smart Life or Tuya Smart account.\n\nYou can find it in the app under **Me** > **Settings** > **Account and Security** > **User Code**. The user code is case-sensitive, enter it exactly as shown in the app."
      },
      "qr_scan": {
        "data": {
          "QR": "QR code"
        },
        "description": "Scan this QR code with the Smart Life or Tuya Smart app.\n\nOpen the scan function of the app (top right of the home screen) and confirm the login. Then press **Submit** here."
      },
      "qr_device": {
        "data": {
          "sharing_device": "Tuya cloud device"
        },
        "description": "The account has {device_count} devices. Select the device you are adding.\n\nThe cloud does not report the Bluetooth MAC address, the address of the device is entered in the next step."
      },
      "qr_address": {
        "description": "The credentials of **{device}** were read from the cloud. Now choose how to set the Bluetooth address of the device.",
        "menu_options": {
          "qr_pick": "Pick a discovered Bluetooth device ({device_count} found)",
          "qr_manual": "Enter the MAC address manually"
        }
      },
      "qr_pick": {
        "data": {
          "address": "Bluetooth device"
        },
        "description": "Select the Bluetooth device that is **{device}**."
      },
      "qr_manual": {
        "data": {
          "address": "MAC address"
        },
        "description": "Enter the MAC address of **{device}** (e.g. {example_mac}).\n\nYou can find it in **Settings** > **Devices & Services** > **Bluetooth**."
      }
    }
  },
